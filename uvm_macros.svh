// UVM macros stub untuk svrust e2e OpenTitan.
// File asli UVM tersedia dari simulasi komersial; stub ini hanya agar
// preprocessor svrust tidak gagal pada `include "uvm_macros.svh"`.
// Semua makro yang tidak didukung diabaikan (diretuskan sebagai teks kosong).

`define uvm_error(id, msg)
`define uvm_warning(id, msg)
`define uvm_info(id, msg, verb)
`define uvm_fatal(id, msg)
`define uvm_object_utils(type)
`define uvm_component_utils(type)
`define uvm_object_utils_begin(type)
`define uvm_object_utils_end
`define uvm_component_utils_begin(type)
`define uvm_component_utils_end
`define uvm_field_int(name, flag)
`define uvm_field_string(name, flag)
`define uvm_field_enum(type, name, flag)
`define uvm_field_sint(name, flag)
`define uvm_field_uint(name, flag)
`define uvm_field_array_int(name, flag)
`define uvm_field_array_string(name, flag)
`define uvm_field_queue_object(name, flag)
`define uvm_field_array_object(name, flag)
`define uvm_field_array_enum(type, name, flag)
`define uvm_do(item)
`define uvm_do_with(item, constraint)
`define uvm_create(item)
`define uvm_send(item)
`define uvm_report_info(id, msg, verb)
`define uvm_report_error(id, msg)
`define uvm_report_warning(id, msg)
`define uvm_report_fatal(id, msg)
